[DllImport("kernel32.dll")]public static extern bool CloseHandle(IntPtr h);
[DllImport("kernel32.dll")]public static extern bool GetExitCodeProcess(IntPtr h,out uint c);
public static IntPtr hp=IntPtr.Zero;public static IntPtr mb=IntPtr.Zero;
public static bool At(string n){
var p=Process.GetProcessesByName(n.Replace(".exe",""));
if(p.Length==0)return false;
hp=OpenProcess(0x0438,false,p[0].Id);
if(hp==IntPtr.Zero)return false;
try{mb=p[0].MainModule.BaseAddress;}catch{mb=IntPtr.Zero;}return true;}
public static bool Av(){if(hp==IntPtr.Zero)return false;uint c;GetExitCodeProcess(hp,out c);return c==259;}
public static void Dt(){if(hp!=IntPtr.Zero){CloseHandle(hp);hp=IntPtr.Zero;}}
public static long RP(long a){byte[] b=new byte[8];int r;ReadProcessMemory(hp,(IntPtr)a,b,8,out r);return BitConverter.ToInt64(b,0);}
public static float RF(long a){byte[] b=new byte[4];int r;ReadProcessMemory(hp,(IntPtr)a,b,4,out r);return BitConverter.ToSingle(b,0);}
public static byte RB(long a){byte[] b=new byte[1];int r;ReadProcessMemory(hp,(IntPtr)a,b,1,out r);return b[0];}
public static void WF(long a,float v){int w;WriteProcessMemory(hp,(IntPtr)a,BitConverter.GetBytes(v),4,out w);}
public static void WB(long a,byte v){int w;WriteProcessMemory(hp,(IntPtr)a,new byte[]{v},1,out w);}
public static void WI(long a,int v){int w;WriteProcessMemory(hp,(IntPtr)a,BitConverter.GetBytes(v),4,out w);}
}
